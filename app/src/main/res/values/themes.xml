<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">#FFC107</item>
    </style>

    <!-- Botão grande, com destaque amarelo forte quando selecionado pelo controle -->
    <style name="TvButton" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:minWidth">200dp</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
